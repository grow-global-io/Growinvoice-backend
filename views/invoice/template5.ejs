<!DOCTYPE html>
<html class="no-js" lang="en" id="html_content">

<head>
  <!-- Meta Tags -->
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="author" content="Laralink">
  <!-- Site Title -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
  <%- include('../styleTag.ejs') %>
</head>

<body>
  <div class="tm_container">
    <div class="tm_invoice_wrap">
      <div class="tm_invoice tm_style3" id="tm_download_section">
        <div class="tm_invoice_in">
          <div class="tm_invoice_head tm_align_center tm_accent_bg">
            <div class="tm_invoice_left">
              <div class="tm_logo">
                <% if (invoice?.user?.company[0]?.logo && invoiceSettings?.invoiceHeadingType ==="COMPANY_LOGO" ) { %>
                  <img src="<%= invoice?.user?.company[0]?.logo %>" alt="Logo">
                  <% } else { %>
                    <h4 >
                      <%= invoice?.user?.company[0]?.name %>
                    </h4>
                    <% } %>
              </div>
            </div>
            <div class="tm_invoice_right">
              <div class="tm_head_address tm_white_color">
                              <p class="tm_mb0">
                  <% if (invoice?.companyAddress ==="") { %>
                  <b style="text-transform: capitalize;">
                    <%= invoice?.user?.company[0]?.name %>
                  </b><br>
                  <%= invoice?.user?.company[0]?.address %><br>
                  <%= invoice?.user?.company[0]?.city %>, <%= invoice?.user?.company[0]?.state?.name %>, <%=
                          invoice?.user?.company[0]?.country?.name %><br>
                  <%= invoice?.user?.company[0]?.zip %><br>

                  <% } else { %>

                  <%- invoice?.companyAddress %>

                  <% }  %>
              </p>
                
              </div>
            </div>
            <div class="tm_primary_color tm_text_uppercase tm_watermark_title tm_white_color"><%= invoice?.paid_status === 'Paid' ? 'Receipt' : 'Invoice' %></div>
          </div>
          <div class="tm_invoice_info">
            <div class="tm_invoice_info_left tm_gray_bg">
              <p class="tm_mb2"><b class="tm_primary_color">Invoice To:</b></p>
              <% if (invoice?.customerBillingAddress ==="") { %>
                <b style="text-transform: capitalize;">
                  <%= invoice?.customer?.name %>
                </b><br>
                <% if (invoice?.customer?.option) { %>
                  <%
                    let businessType = '';
                    switch(invoice?.customer?.option) {
                      case 'BusinessWithGST':
                        businessType = 'BusinesswithGST';
                        break;
                      case 'BusinessWithoutGST':
                        businessType = 'BusinesswithoutGST';
                        break;
                      case 'Freelancer':
                        businessType = 'Freelancer';
                        break;
                      default:
                        businessType = invoice?.customer?.option;
                    }
                  %>
                  <span style="text-transform: capitalize;"><%= businessType %></span><br>
                <% } %>
                <% if (invoice?.customer?.email) { %>
                  <%= invoice?.customer?.email %><br>
                <% } %>
                <%= invoice?.customer?.billingAddress?.address %><br>
                <%= invoice?.customer?.billingAddress?.city %>, <%= invoice?.customer?.billingAddress?.state?.name %>,
                <%= invoice?.customer?.billingAddress?.country?.name %><br>
                <%= invoice?.customer?.billingAddress?.zip %><br>
                <% } else { %>

                <%- invoice?.customerBillingAddress %>
                <% if (invoice?.customer?.email) { %>
                  <br><%= invoice?.customer?.email %>
                <% } %>

                <% }  %>

            </div>
            <div class="tm_invoice_info_right tm_text_right">
              <p class="tm_invoice_number tm_m0">Invoice No: <b class="tm_primary_color">#<%= invoiceSettings?.invoicePrefix ?? "INV" %>-<%= invoice?.invoice_number %></b></p>
              <p class="tm_invoice_date tm_m0">Date: <b class="tm_primary_color"><%= new Date(invoice?.date)?.toISOString()?.split('T')[0] %></b></p>
            </div>
          </div>
          <div class="tm_invoice_details">
            <div class="tm_table tm_style1 tm_mb30">
              <div class="tm_border">
                <div class="tm_table_responsive">
                  <table class="tm_gray_bg">
                    <thead>
                      <tr>
                        <th class="tm_width_2 tm_semi_bold tm_white_color tm_accent_bg">
                          S. No</th>
                        <th class="tm_width_3 tm_semi_bold tm_white_color tm_accent_bg">
                          Item</th>
                        <th class="tm_width_1 tm_semi_bold tm_white_color tm_accent_bg tm_border_left">
                          Qty</th>
                        <th class="tm_width_1 tm_semi_bold tm_white_color tm_accent_bg tm_border_left">
                          HSN</th>
                        <th class="tm_width_1 tm_semi_bold tm_white_color tm_accent_bg tm_border_left">
                          Tax(%)</th>
                        <th class="tm_width_2 tm_semi_bold tm_white_color tm_accent_bg tm_border_left">
                          Price</th>
                        <th class="tm_width_2 tm_semi_bold tm_white_color tm_accent_bg tm_border_left tm_text_right">
                          Total</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% invoice?.product?.forEach(product=> { %>
                      <tr>
                        <td class="tm_width_2">
                          <%= invoice?.product?.indexOf(product) + 1 %>
                        </td>
                        <td class="tm_width_3 tm_border_left">
                          <%= product?.product?.name %>
                        </td>
                        <td class="tm_width_1 tm_border_left">
                          <%= product?.quantity %>
                        </td>
                        <td class="tm_width_1 tm_border_left">
                          <%= product?.product?.hsnCode?.code %>
                        </td>
                        <td class="tm_width_1 tm_border_left">
                          <%= product?.product?.tax?.percentage %>%
                        </td>
                        <td class="tm_width_2 tm_border_left">
                          <%= product?.product?.currency?.symbol %>
                          <%= product?.price %>
                        </td>
                        <td class="tm_width_2 tm_border_left tm_text_right">
                          <%= product?.product?.currency?.symbol %>
                          <%= product?.total %>
                        </td>
                      </tr>

                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
              <div class="tm_invoice_footer">
                <div class="tm_left_footer">
                  <% if(invoice?.notes !==null && invoice?.notes !=="" ){ %>
                    <div class="tm_note tm_font_style_normal border p-2 m-0">
                      <b class="tm_primary_color">Note:</b>
                      <%= invoice?.notes ?? "Thank you for your business!" %>
                    </div>
                    <% } %>
                  <!-- <p class="tm_mb2"><b class="tm_primary_color">Payment info:</b></p>
                  <p class="tm_m0">Credit Card - 236***********928 <br>Amount: $1732</p> -->
                </div>
                <div class="tm_right_footer">
                  <table class="tm_gray_bg">
                    <tbody>
                      <tr>
                        <td class="tm_width_3 tm_primary_color tm_bold">Subtoal</td>
                        <td class="tm_width_3 tm_primary_color tm_text_right tm_bold"><%= invoice?.product[0]?.product?.currency?.symbol %>
                          <%= invoice?.paid_status === 'Paid' ? '0.00' : invoice?.sub_total %></td>
                      </tr>
                     <% if(invoice?.tax_id !==null ){ %>

                      <tr class="tm_gray_bg">
                        <td class="tm_width_3 tm_primary_color">Tax <span class="tm_ternary_color">(<%=
                              invoice?.tax?.percentage %>%)</span></td>
                        <td class="tm_width_3 tm_primary_color tm_text_right">
                          <%= invoice?.product[0]?.product?.currency?.symbol %>
                          <%= ((invoice?.tax?.percentage / 100) * invoice?.sub_total).toFixed(2) %>
                        </td>
                      </tr>
                      <% } %>
                     <% if(invoice?.discountPercentage !==null || invoice?.discountPercentage >0 ){ %>

                      <tr class="tm_gray_bg">
                        <td class="tm_width_3 tm_primary_color">Discount <span class="tm_ternary_color">(<%=
                                  invoice?.discountPercentage %>%)</span></td>
                        <td class="tm_width_3 tm_primary_color tm_text_right">
                          <%= invoice?.product[0]?.product?.currency?.symbol %>
                           <%= ((invoice?.discountPercentage / 100) * invoice?.sub_total).toFixed(2) %>
                        </td>
                      </tr>
                      <% } %>
                      <tr class="tm_gray_bg">
                        <td class="tm_width_3 tm_primary_color text-danger font-weight-bold">Due Amount </td>
                        <td class="tm_width_3 tm_primary_color tm_text_right text-danger font-weight-bold">
                          <%= invoice?.product[0]?.product?.currency?.symbol %>
                          <%= invoice?.due_amount %>
                        </td>
                      </tr>
                      <tr class="tm_gray_bg">
                        <td class="tm_width_3 tm_primary_color text-success font-weight-bold">Paid Amount </td>
                        <td class="tm_width_3 tm_primary_color tm_text_right text-success font-weight-bold">
                          <%= invoice?.product[0]?.product?.currency?.symbol %>
                          <%= invoice?.paid_amount %>
                        </td>
                      </tr>
                      
                      <tr class="tm_border_top tm_border_bottom tm_accent_bg">
                        <td class="tm_width_3 tm_border_top_0 tm_bold tm_f16 tm_white_color">Grand Total
                        </td>
                        <td class="tm_width_3 tm_border_top_0 tm_bold tm_f16 tm_white_color tm_text_right">
                           <%= invoice?.product[0]?.product?.currency?.symbol %>
                           <%= invoice?.total %></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
              <div class="tm_invoice_head tm_mb10" style="height: auto">
                <div class="tm_invoice_left" style="width: 49%">
                  <table class="table table-bordered">
                    <tr>
                      <td class="font-weight-bold left">Company:</td>
                      <td class="left">
                        <%= invoice?.user?.company[0]?.name %>
                      </td>
                    </tr>
                    <tr>
                      <td class="font-weight-bold">Address:</td>
                      <td>
                        <%= invoice?.user?.company[0]?.address %><br>
                        <%= invoice?.user?.company[0]?.city %>, <%= invoice?.user?.company[0]?.state?.name %>, <%=
                              invoice?.user?.company[0]?.country?.name %><br>
                        <%= invoice?.user?.company[0]?.zip %><br>
                      </td>
                    </tr>
                    <tr>
                      <td class="font-weight-bold">VAT Number:</td>
                      <td>
                        <%= invoice?.user?.company[0]?.vat %>
                      </td>
                    </tr>
                    <tr>
                      <td class="font-weight-bold">Email:</td>
                      <td>
                        <%= invoice?.user?.email %>
                      </td>
                    </tr>
                  </table>
                </div>
                <div class="tm_invoice_right tm_text_right" style="width: 49%;text-align:left">
                  <table class="table table-bordered float-right">
                    <tr>
                      <td class="font-weight-bold mr-2">Tel:</td>
                      <td style="text-align:left">
                        <%= invoice?.user?.company[0]?.phone %>
                      </td>
                    </tr>
                    <!-- <tr>
                    <td class="font-weight-bold mr-2">WWW:</td>
                    <td>{{ $invoice->company->website }}</td>
                  </tr> -->
                  </table>
                </div>
              </div>
              <div>
                <hr />
              </div>
              <div class="m-0">
                <table class="table table-bordered">
                  <tr>
                    <td class="w-50">
                      Recipient's
                      <%= invoice?.payment?.paymentType ==="UPI"? invoice?.payment?.paymentType : invoice?.payment?.paymentType.replace(/([a-z])([A-Z])/g, "$1 $2")
                    .replace(/([A-Z])([A-Z][a-z])/g, "$1 $2") 
                    .replace(/([a-z])([A-Z])/g, "$1 $2")
                    .replace(/([A-Z])([A-Z])/g, "$1 $2")
                    .trim();  %>

                      Details
                    </td>
                    <td class="w-50">
                      <% 
                    if(invoice?.payment?.paymentType === 'EuropeanBank'){ %>
                      %>
                      <% if(invoice?.payment?.bankName){ %>
                        <span class="ibanNumberTitleTextField font-weight-bold">Bank Name</span>
                        <span class="ibanNumberTextField">
                          <%= invoice?.payment?.bankName %>
                        </span>
                        <br>
                      <% } %>
                      <% if(invoice?.payment?.ibanNumber){ %>
                        <span class="ibanNumberTitleTextField font-weight-bold">IBAN</span>
                        <span class="ibanNumberTextField">
                          <%= invoice?.payment?.ibanNumber %>
                        </span>
                        <br>
                      <% } %>
                      <% if(invoice?.payment?.bicNumber){ %>
                        <span class="bicNumberTitleTextField font-weight-bold">BIC</span>
                        <span class="bicNumberTextField">
                          <%= invoice?.payment?.bicNumber %></span>
                      <% } %>
                      <% } %>
                      <% 
                    if(invoice?.payment?.paymentType === 'IndianBanks'){ %>
                      %>
                      <span class="ibanNumberTitleTextField font-weight-bold">AC No.</span>
                      <span class="ibanNumberTextField">
                        <%= invoice?.payment?.account_no %></span>
                      <br>
                      <span class="bicNumberTitleTextField font-weight-bold">IFSC</span>
                      <span class="bicNumberTextField">
                        <%= invoice?.payment?.ifscCode %></span>
                      <% } %>
                      <% 
                    if(invoice?.payment?.paymentType === 'UPI'){ %>
                      %>
                      <span class="ibanNumberTitleTextField font-weight-bold">UPI Id:</span>
                      <span class="ibanNumberTextField">
                        <%= invoice?.payment?.upiId %>
                      </span>
                      <% } %>

                      <% 
                    if(invoice?.payment?.paymentType === 'SwiftCode'){ %>
                      %>
                      <span class="ibanNumberTitleTextField font-weight-bold">Swift Code</span>
                      <span class="ibanNumberTextField swiftCodeValue">
                        <%= invoice?.payment?.swiftCode %></span>
                      <% } %>
                      <% 
                    if(invoice?.payment?.paymentType === 'Paypal'){ %>
                      %>
                      <span class="ibanNumberTitleTextField font-weight-bold">Paypal</span>
                      <span class="ibanNumberTextField swiftCodeValue">
                        <%= invoice?.payment?.paypalId %></span>
                      <% } %>
                      <% 
                    if(invoice?.payment?.paymentType === 'Stripe'){ %>
                      %>
                      <span class="ibanNumberTitleTextField font-weight-bold">Stripe</span>
                      <span class="ibanNumberTextField swiftCodeValue">
                        <%= invoice?.payment?.stripeId %></span>
                      <% } %>
                      <% 
                    if(invoice?.payment?.paymentType === 'Razorpay'){ %>
                      %>
                      <span class="ibanNumberTitleTextField font-weight-bold">Razorpay</span>
                      <span class="ibanNumberTextField swiftCodeValue">
                        <%= invoice?.payment?.razorpayId %></span>
                      <% } %>
                      <% 
                    if(invoice?.payment?.paymentType === 'Mollie'){ %>
                      %>
                      <span class="ibanNumberTitleTextField font-weight-bold">Mollie</span>
                      <span class="ibanNumberTextField swiftCodeValue">
                        <%= invoice?.payment?.mollieId %></span>
                      <% } %>
                      <% 
                    if(invoice?.payment?.paymentType === 'Cash'){ %>
                      %>
                      <span class="ibanNumberTitleTextField font-weight-bold">Cash</span>
                      <% } %>
                      <% 
                    if(invoice?.payment?.paymentType === 'Cheque'){ %>
                      %>
                      <span class="ibanNumberTitleTextField font-weight-bold">Cheque</span>
                      <% } %>
                    </td>
                  </tr>
                  <tr>
                    <td>Recipient's Details</td>
                    <td>
                      <div class="templateTo">
                        <p>
                          <% if (invoice?.companyAddress ==="") { %>
                          <b style="text-transform: capitalize;">
                            <%= invoice?.user?.company[0]?.name %>
                          </b><br>
                          <%= invoice?.user?.company[0]?.address %><br>
                          <%= invoice?.user?.company[0]?.city %>, <%= invoice?.user?.company[0]?.state?.name %>, <%=
                          invoice?.user?.company[0]?.country?.name %><br>
                          <%= invoice?.user?.company[0]?.zip %><br>
                          <% if (invoice?.customer?.email) { %>
                            <%= invoice?.customer?.email %><br>
                          <% } %>

                          <% } else { %>

                          <%- invoice?.companyAddress %>
                          <% if (invoice?.customer?.email) { %>
                            <br><%= invoice?.customer?.email %>
                          <% } %>

                          <% }  %>
                        </p>
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td>Payer's Name & Address</td>
                    <td>
                      <div class="templateTo">
                        <p>
                          <% if (invoice?.customerBillingAddress ==="") { %>
                          <b style="text-transform: capitalize;">
                            <%= invoice?.customer?.name %>
                          </b><br>
                          <% if (invoice?.customer?.option) { %>
                            <%
                              let businessTypePayer = '';
                              switch(invoice?.customer?.option) {
                                case 'BusinessWithGST':
                                  businessTypePayer = 'BusinesswithGST';
                                  break;
                                case 'BusinessWithoutGST':
                                  businessTypePayer = 'BusinesswithoutGST';
                                  break;
                                case 'Freelancer':
                                  businessTypePayer = 'Freelancer';
                                  break;
                                default:
                                  businessTypePayer = invoice?.customer?.option;
                              }
                            %>
                            <span style="text-transform: capitalize;"><%= businessTypePayer %></span><br>
                          <% } %>
                          <%= invoice?.customer?.billingAddress?.address %><br>
                          <%= invoice?.customer?.billingAddress?.city %>, <%= invoice?.customer?.billingAddress?.state?.name %>,
                          <%= invoice?.customer?.billingAddress?.country?.name %><br>
                          <%= invoice?.customer?.billingAddress?.zip %><br>
                          <% } else { %>

                          <%- invoice?.customerBillingAddress %>

                          <% }  %>

                        </p>
                      </div>
                    </td>
                  </tr>
                  <tr>

                    <td colspan="2" class="p-0">
                      <table class="w-100">
                        <tr>
                          <td>Ref. No.</td>
                          <td>
                            <%= invoice?.reference_number ?? invoice?.invoice_number %>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td colspan="2" class="p-0">
                      <table class="w-100">
                        <tr>
                          <td>Due Date</td>
                          <td>
                            <%= new Date(invoice?.due_date)?.toISOString()?.split('T')[0] %>
                          </td>
                          <td>
                            <%= invoice?.product[0]?.product?.currency?.symbol %>
                            <%= invoice?.total %>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </div>
              <div class="row">
            <div class="col">
              <%= footer?.text %>
            </div>
          </div>
          <br/>
              <div class="row">
                <div class="col">
                  <%- invoiceSettings?.footer ?? "The payment will be cleared for the recipient in accordance with the General items for payment transmission and only on the basis of the account number given by the payer." %>
                </div>
              </div>
              </div>
            
          </div>
        </div>
      </div>

    </div>
  </div>
</body>

</html>