<!doctype html>
<html lang="en" id="html_content">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receipt</title>
    <style>
      body {
        font-family: 'Courier New', Courier, monospace;
        color: #000;
        background: #fff;
        line-height: 1.5em;
      }
      .receipt-box {
        max-width: auto;
        margin: auto;
        padding: 20px;
        border: 1px solid #ccc;
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.15);
        font-size: 14px;
      }
      .header {
        text-align: center;
        margin-bottom: 20px;
      }
      .header .logo {
        font-size: 40px;
        font-weight: bold;
        background-color: #f0e6d2; /* A beige-like color from the image */
        color: #000;
        display: inline-block;
        width: 50px;
        height: 50px;
        line-height: 50px;
        margin-bottom: 10px;
      }
      .header h2 {
        margin: 0;
        font-size: 18px;
        font-weight: bold;
      }
      .header h3 {
        margin: 5px 0;
        font-size: 16px;
        font-weight: normal;
      }
      .header p {
        margin: 2px 0;
        font-size: 12px;
      }
      .invoice-title {
        text-align: center;
        font-weight: bold;
        margin-bottom: 15px;
        border-top: 1px dashed #000;
        border-bottom: 1px dashed #000;
        padding: 5px 0;
      }
      .receipt-box table {
        width: 100%;
        line-height: inherit;
        text-align: left;
        border-collapse: collapse;
      }
      .receipt-box table td {
        padding: 5px;
        vertical-align: top;
      }
      .info-table td {
        padding: 1px 0;
      }
      .items-table th {
        background: #fff;
        border-top: 1px solid #000;
        border-bottom: 1px solid #000;
        font-weight: bold;
        text-align: left;
        padding: 5px;
      }
      .items-table td {
        border-bottom: 1px dashed #ccc;
        padding: 8px 5px;
      }
      .items-table .item.last td {
        border-bottom: none;
      }
      .totals-table td {
        padding: 2px 5px;
      }
      .totals-table tr.final-total td {
        border-top: 1px solid #000;
        border-bottom: 1px solid #000;
        font-weight: bold;
        padding: 8px 5px;
      }
      .text-right {
        text-align: right;
      }
      .footer {
        margin-top: 20px;
        text-transform: uppercase;
      }
    </style>
  </head>

  <body>
    <div class="receipt-box"  id="tm_download_section">
      <div class="header"><% if (invoice?.user?.company[0]?.logo && invoiceSettings?.invoiceHeadingType ==="COMPANY_LOGO" ) { %>
        <img src="<%= invoice?.user?.company[0]?.logo %>" alt="Logo" class="logo" style="width: 50px; height: 50px; object-fit: cover;">
        <% }%>
        <h2> <%= invoice?.user?.company[0]?.name %></h2>
        <h3> <%= invoice?.user?.company[0]?.address %></h3>
        <p><%= invoice?.user?.company[0]?.city %>, <%= invoice?.user?.company[0]?.state?.name %>, <%=
          invoice?.user?.company[0]?.country?.name %></p>
        <p> <%= invoice?.user?.company[0]?.zip %></p>
        <p> <%- invoice?.companyAddress %></p>
      </div>

      <div class="invoice-title">Tax Invoice</div>

      <table class="info-table" style="margin-bottom: 15px;">
        <tr>
          <td>DATE:  <%= new Date(invoice?.date)?.toISOString()?.split('T')[0] %></td>
          <td class="text-right">KOTBOT: <%= invoice?.payment?.paymentType %></td>
        </tr>
        <tr>
          <td>INVOICE NO: #<%= invoiceSettings?.invoicePrefix ?? "INV" %>-<%=
            invoice?.invoice_number %></td>
        </tr>
      </table>

      <table class="items-table">
        <thead>
          <tr>
            <th>Item</th>
            <th>Qty</th>
            <th class="text-right">Tax(%)</th>
            <th class="text-right">HSN</th>
            <th class="text-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% invoice?.product?.forEach(product=> { %>
            <tr class="item">
              <td >
                <%= product?.product?.name %>
              </td>
              <td>
                <%= product?.quantity %>
              </td>
              <td class="text-right">
                <%= product?.product?.tax?.percentage %>%
              </td>
              <td>
                <%= product?.product?.hsnCode?.code %>-<%= product?.product?.hsnCode?.tax?.percentage %>%
              </td>
              <td class="text-right">
                <%= product?.product?.currency?.symbol %>
                  <%= product?.total %>
              </td>
            </tr>

            <% }) %>
        </tbody>
      </table>

      <table class="totals-table" style="margin-top: 15px;">
        <tr>
          <td>Sub Total</td>
          <td class="text-right"> <%= invoice?.product[0]?.product?.currency?.symbol %>
            <%= invoice?.sub_total %></td>
        </tr>
        <tr>
          <td>Tax <span class="tm_ternary_color">(<%= invoice?.tax?.percentage ?? 0 %>%)</span></td>
          <td class="text-right"> <%= invoice?.product[0]?.product?.currency?.symbol %>
            <%= ((invoice?.tax?.percentage ?? 0 / 100) * invoice?.sub_total).toFixed(2) %></td>
        </tr>
        <tr>
          <td>Tax Discount <span class="tm_ternary_color">(<%=
            invoice?.discountPercentage %>%)</span></td>
          <td class="text-right"> <%= invoice?.product[0]?.product?.currency?.symbol %>
            <%= ((invoice?.discountPercentage ?? 0 / 100) * invoice?.sub_total).toFixed(2) %></td>
        </tr>
        <tr class="final-total">
          <td>Net Bill Amount:</td>
          <td class="text-right"> <%= invoice?.product[0]?.product?.currency?.symbol %>
            <%= invoice?.total %>
        </tr>
      </table>

      <div class="footer">
        <p><%= invoice?.notes ?? "Thank you for your business!" %></p>
      </div>
    </div>
  </body>
</html>