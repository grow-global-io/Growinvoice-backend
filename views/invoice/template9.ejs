<!doctype html>
<html lang="en" id="html_content">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receipt</title>
    <style>
      /* print style to portait */
      @media print {
        @page {
          size: auto;
          margin: 0;
        }
        body {
          margin: 0;
          padding: 0;
          font-size: 12px;
        }
        #html_content {
          width: 100%;
          height: 100%;
        }
        .receipt-box {
          width: 100%;
          max-width: 100%;
          margin: 0;
          padding: 0;
          border: none;
          box-shadow: none;
        }
        .receipt-box .header {
          margin-bottom: 10px;
        }
        .receipt-box .header .logo {
          width: 50px;
          height: 50px;
          line-height: 50px;
          font-size: 40px;
        }
        .receipt-box .header h2 {
          font-size: 18px;
        }
        .receipt-box .header h3 {
          font-size: 16px;
        }
        .receipt-box .header p {
          font-size: 12px;
        }
        .receipt-box .invoice-title {
          font-size: 16px;
          margin-bottom: 10px;
        }
        .receipt-box table {
          width: 100%;
          font-size: 12px;
        }
        .receipt-box table td {
          padding: 2px;
        }
        .receipt-box .items-table th {
          font-size: 12px;
        }
        .receipt-box .items-table td {
          font-size: 12px;
          padding: 4px 2px;
        }
        .receipt-box .totals-table td {
          font-size: 12px;
          padding: 2px 2px;
        }
        .receipt-box .totals-table tr.final-total td {
          font-size: 14px;
          padding: 4px 2px;
        }
        .receipt-box .footer {
          font-size: 12px;
          margin-top: 10px;
        }
        /* print layout = portrait */
        @page {
          size: portrait;
        }
      }
      body {
        font-family: Arial, sans-serif;
        color: #000;
        background: #fff;
        line-height: 1.5em;
        margin: 0;
        padding: 0;
      }
      .receipt-box {
        /* MODIFICATION: Set a max-width suitable for 80mm thermal printers */
        max-width: 300px;
        margin: auto;
        /* MODIFICATION: Adjust padding and font size for the smaller format */
        padding: 10px;
        border: 1px solid #ccc;
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.15);
        font-size: 12px;
      }
      .header {
        text-align: center;
        margin-bottom: 20px;
      }
      .header .logo {
        font-size: 40px;
        font-weight: bold;
        background-color: #f0e6d2; /* A beige-like color from the image */
        color: #000;
        display: inline-block;
        width: 50px;
        height: 50px;
        line-height: 50px;
        margin-bottom: 10px;
      }
      .header h2 {
        margin: 0;
        font-size: 18px;
        font-weight: bold;
      }
      .header h3 {
        margin: 5px 0;
        font-size: 16px;
        font-weight: normal;
      }
      .header p {
        margin: 2px 0;
        font-size: 12px;
      }
      .invoice-title {
        text-align: center;
        font-weight: bold;
        margin-bottom: 15px;
        border-top: 1px dashed #000;
        border-bottom: 1px dashed #000;
        padding: 5px 0;
      }
      .receipt-box table {
        width: 100%;
        line-height: inherit;
        text-align: left;
        border-collapse: collapse;
      }
      .receipt-box table td {
        padding: 5px;
        vertical-align: top;
      }
      .info-table td {
        padding: 1px 0;
      }
      .items-table th {
        background: #fff;
        border-top: 1px solid #000;
        border-bottom: 1px solid #000;
        font-weight: bold;
        text-align: left;
        padding: 5px;
      }
      /* MODIFICATION: Remove default border from item rows */
      .items-table td {
        border-bottom: none;
        padding: 8px 5px;
      }
      .items-table .item.last td {
        border-bottom: none;
      }
      .totals-table td {
        padding: 2px 5px;
      }
      .totals-table tr.final-total td {
        border-top: 1px solid #000;
        border-bottom: 1px solid #000;
        font-weight: bold;
        padding: 8px 5px;
      }
      .text-right {
        text-align: right;
      }
      .footer {
        margin-top: 20px;
        text-transform: uppercase;
      }
    </style>
  </head>

  <body>
    <div class="receipt-box"  id="tm_download_section">
      <div class="header"><% if (invoice?.user?.company[0]?.logo && invoiceSettings?.invoiceHeadingType ==="COMPANY_LOGO" ) { %>
        <img src="<%= invoice?.user?.company[0]?.logo %>" alt="Logo" class="logo" style="width: 50px; height: 50px; object-fit: cover;">
        <% }%>
        <h2> <%= invoice?.user?.company[0]?.name %></h2>
        <h3> <%= invoice?.user?.company[0]?.address %></h3>
        <p><%= invoice?.user?.company[0]?.city %>, <%= invoice?.user?.company[0]?.state?.name %>, <%=
          invoice?.user?.company[0]?.country?.name %></p>
        <p> <%= invoice?.user?.company[0]?.zip %></p>
        <p> <%- invoice?.companyAddress %></p>
        <p> <%- invoice?.user?.company[0]?.vat %></p>

      </div>

      <div class="invoice-title">Tax Invoice</div>

      <!-- MODIFICATION: Information is now stacked vertically to prevent overflow -->
      <table class="info-table" style="margin-bottom: 15px;" aria-hidden="true">
        <tr><td>DATE: <%= new Date(invoice?.date)?.toISOString()?.split('T')[0] %></td></tr>
        <tr><td>INVOICE NO: #<%= invoiceSettings?.invoicePrefix ?? "INV" %>-<%= invoice?.invoice_number %></td></tr>
        <tr><td>Payment Type: <%= invoice?.payment?.paymentType %></td></tr>
      </table>

      <!-- MODIFICATION: Items table is restructured for narrow receipts -->
      <table class="items-table">
        <thead>
          <tr>
            <th>Item</th>
            <th class="text-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% invoice?.product?.forEach(product=> { %>
            <tr class="item">
              <td style="padding-bottom: 2px;">
                <%= product?.product?.name %>
              </td>
              <td class="text-right" style="padding-bottom: 2px;">
                <%= product?.product?.currency?.symbol %> <%= product?.total %>
              </td>
            </tr>
            <tr class="item-details">
              <td colspan="2" style="padding-top: 0; font-size: 11px; border-bottom: 1px dashed #ccc;">
                Qty: <%= product?.quantity %> | HSN: <%= product?.product?.hsnCode?.code %> | Tax: <%= product?.product?.tax?.percentage %>%
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <table class="totals-table" style="margin-top: 15px;">
        <tr>
          <td>Sub Total</td>
          <td class="text-right"> <%= invoice?.product[0]?.product?.currency?.symbol %>
            <%= invoice?.sub_total %></td>
        </tr>
        <tr>
          <td>Tax <span class="tm_ternary_color">(<%= invoice?.tax?.percentage ?? 0 %>%)</span></td>
          <td class="text-right"> <%= invoice?.product[0]?.product?.currency?.symbol %>
            <%= ((invoice?.tax?.percentage ?? 0 / 100) * invoice?.sub_total).toFixed(2) %></td>
        </tr>
        <tr>
          <td>Tax Discount <span class="tm_ternary_color">(<%=
            invoice?.discountPercentage %>%)</span></td>
          <td class="text-right"> <%= invoice?.product[0]?.product?.currency?.symbol %>
            <%= ((invoice?.discountPercentage ?? 0 / 100) * invoice?.sub_total).toFixed(2) %></td>
        </tr>
        <tr class="final-total">
          <td>Net Bill Amount:</td>
          <td class="text-right"> <%= invoice?.product[0]?.product?.currency?.symbol %>
            <%= invoice?.total %>
        </tr>
      </table>

      <div class="footer">
        <p><%= invoice?.notes ?? "Thank you for your business!" %></p>
      </div>
    </div>
  </body>
</html>