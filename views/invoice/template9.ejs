<!doctype html>
<html lang="en" id="html_content">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receipt</title>
    <style>
      *, *:before, *:after {
        box-sizing: border-box;
      }
      @media print {
        @page {
          size: 58mm 120mm;
          margin: 0;
        }
      }
      
      /* Unified styles for both screen and print */
      html, body {
        width: 100%;
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        color: #000;
        background: #fff;
        line-height: 1.4em;
        font-size: 10px;
      }
      
      .receipt-box {
        width: 100%;
        max-width: 300px;
        margin: 0 auto;
        padding: 2mm 6mm;
      }
      
      /* Add border and shadow ONLY in screen preview */
      @media screen {
        .receipt-box {
          border: 1px solid #ccc;
          box-shadow: 0 0 5px rgba(0, 0, 0, 0.15);
        }
      }
      
      .header {
        text-align: center;
        margin-bottom: 5px;
      }
      .header .logo {
        font-size: 30px;
        font-weight: bold;
        background-color: #f0e6d2; /* Beige color for logo */
        color: #000;
        display: inline-block;
        width: 40px;
        height: 40px;
        line-height: 40px;
        margin-bottom: 10px;
      }
      .header h2 {
        margin: 0;
        font-size: 12px;
        font-weight: bold;
      }
      .header h3 {
        margin: 5px 0;
        font-size: 10px;
        font-weight: normal;
      }
      .header p {
        margin: 1px 0;
        font-size: 9px;
      }
      .invoice-title {
        text-align: center;
        font-weight: bold;
        margin-bottom: 5px;
        border-top: 1px dashed #000;
        border-bottom: 1px dashed #000;
        padding: 2px 0;
        font-size: 11px;
      }
      .receipt-box table {
        width: 100%;
        line-height: inherit;
        text-align: left;
        border-collapse: collapse;
        font-size: 9px;
      }
      .receipt-box table td {
        padding: 1px;
        vertical-align: top;
      }
      .info-table td {
        padding: 1px 0;
      }
      .items-table th {
        background: #fff;
        border-top: 1px solid #000;
        border-bottom: 1px solid #000;
        font-weight: bold;
        text-align: left;
        padding: 3px 1px;
        font-size: 9px;
      }
      .items-table td {
        border-bottom: none;
        padding: 3px 1px;
        font-size: 9px;
      }
      .items-table .item.last td {
        border-bottom: none;
      }
      .receipt-box .items-table .item-details td {
        font-size: 8px !important;
        border-bottom: 1px dashed #ccc !important;
        padding-top: 0;
      }
      .totals-table td {
        padding: 1px 1px;
        font-size: 9px;
      }
      .totals-table tr.final-total td {
        border-top: 1px solid #000;
        border-bottom: 1px solid #000;
        font-weight: bold;
        padding: 3px 1px;
        font-size: 11px;
      }
      .text-right {
        text-align: right !important;
      }
      .footer {
        margin-top: 5px;
        text-transform: uppercase;
        font-size: 9px;
      }
    </style>
  </head>

  <body>
    <div class="receipt-box"  id="tm_download_section">
      <div class="header"><% if (invoice?.user?.company[0]?.logo && invoiceSettings?.invoiceHeadingType ==="COMPANY_LOGO" ) { %>
        <img src="<%= invoice?.user?.company[0]?.logo %>" alt="Logo" class="logo" style="width: 50px; height: 50px; object-fit: cover;">
        <% }%>
        <h2> <%= invoice?.user?.company[0]?.name %></h2>
        <h3> <%= invoice?.user?.company[0]?.address %></h3>
        <p><%= invoice?.user?.company[0]?.city %>, <%= invoice?.user?.company[0]?.state?.name %>, <%=
          invoice?.user?.company[0]?.country?.name %></p>
        <p> <%= invoice?.user?.company[0]?.zip %></p>
        <p> <%- invoice?.companyAddress %></p>
        <p> <%- invoice?.user?.company[0]?.vat %></p>

      </div>

      <div class="invoice-title"><%= invoice?.paid_status === 'Paid' ? t('translation.invoice.template.receipt') : t('translation.invoice.template.invoice') %></div>

      <!-- MODIFICATION: Information is now stacked vertically to prevent overflow -->
      <table class="info-table" style="margin-bottom: 15px;" aria-hidden="true">
        <tr><td><%= t('translation.invoice.template.date') %> <%= new Date(invoice?.date)?.toISOString()?.split('T')[0] %></td></tr>
        <tr><td><%= t('translation.invoice.template.invoiceNo') %> #<%= invoiceSettings?.invoicePrefix ?? "INV" %>-<%= invoice?.invoice_number %></td></tr>
        <tr><td><%= t('translation.invoice.template.paymentMethod') %> <%= invoice?.payment?.paymentType %></td></tr>
      </table>

      <!-- MODIFICATION: Items table is restructured for narrow receipts -->
      <table class="items-table">
        <thead>
          <tr>
            <th><%= t('translation.invoice.template.item') %></th>
            <th class="text-right"><%= t('translation.invoice.table.amount') %></th>
          </tr>
        </thead>
        <tbody>
          <% invoice?.product?.forEach(product=> { %>
            <tr class="item">
              <td style="padding-bottom: 2px;">
                <%= product?.product?.name %>
              </td>
              <td class="text-right" style="padding-bottom: 2px;">
                <%= product?.product?.currency?.symbol %> <%= product?.total %>
              </td>
            </tr>
            <tr class="item-details">
              <td colspan="2" style="padding-top: 0; font-size: 11px; border-bottom: 1px dashed #ccc;">
                <%= t('translation.invoice.template.qty') %>: <%= product?.quantity %> | HSN: <%= product?.product?.hsnCode?.code %> | Tax: <%= product?.product?.tax?.percentage %>% | <%= t('translation.invoice.template.productDiscount') %>: <%= product?.discount || 0 %>%
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <% 
        let calculatedTaxAmount = 0;
        let taxPercentageString = '';
        if (invoice?.tax) {
          calculatedTaxAmount = ((invoice.tax.percentage ?? 0) / 100) * invoice.sub_total;
          taxPercentageString = `${invoice.tax.percentage}%`;
        } else {
          // Sum up the tax from each product
          invoice?.product?.forEach(item => {
            const itemTaxPercent = item?.product?.tax?.percentage || 0;
            const itemTotalBeforeTax = item.total || 0;
            calculatedTaxAmount += (itemTotalBeforeTax * itemTaxPercent) / 100;
          });
          
          const taxRates = new Set();
          invoice?.product?.forEach(item => {
            if (item?.product?.tax?.percentage !== undefined && item?.product?.tax?.percentage !== null) {
              taxRates.add(item.product.tax.percentage);
            }
          });
          if (taxRates.size === 1) {
            taxPercentageString = `${Array.from(taxRates)[0]}%`;
          } else if (taxRates.size > 1) {
            taxPercentageString = 'Mixed';
          } else {
            taxPercentageString = '0%';
          }
        }
      %>

      <table class="totals-table" style="margin-top: 15px;">
        <tr>
          <td><%= t('translation.invoice.template.subtotal') %></td>
          <td class="text-right"> <%= invoice?.product[0]?.product?.currency?.symbol %>
            <%= invoice?.sub_total %></td>
        </tr>
        <tr>
          <td><%= t('translation.invoice.template.tax') %> <span class="tm_ternary_color">(<%= taxPercentageString %>)</span></td>
          <td class="text-right"> <%= invoice?.product[0]?.product?.currency?.symbol %>
            <%= calculatedTaxAmount.toFixed(2) %></td>
        </tr>
        <tr>
          <td><%= t('translation.invoice.template.taxDiscount') %> <span class="tm_ternary_color">(<%=
            invoice?.discountPercentage %>%)</span></td>
          <td class="text-right"> <%= invoice?.product[0]?.product?.currency?.symbol %>
            <%= (((invoice?.discountPercentage ?? 0) / 100) * invoice?.sub_total).toFixed(2) %></td>
        </tr>
        <tr class="final-total">
          <td><%= t('translation.invoice.template.netBillAmount') %></td>
          <td class="text-right"> <%= invoice?.product[0]?.product?.currency?.symbol %>
            <%= invoice?.total %>
        </tr>
      </table>

      <div class="footer">
        <p><%= invoice?.notes ?? t('translation.invoice.template.thankYouMessage') %></p>
      </div>
    </div>

    <script>
      (function() {
        function adjustPageHeight() {
          const receipt = document.getElementById('tm_download_section');
          if (receipt) {
            const heightPx = receipt.offsetHeight;
            // Convert pixels to millimeters (1px = 25.4/96 mm = ~0.264583 mm)
            const computedHeight = Math.ceil(heightPx * 0.264583) + 12; // 12mm safety padding/margin buffer
            const minHeight = 90; // Enforce a sensible minimum height
            const heightMm = Math.max(minHeight, computedHeight);
            
            // Look for existing dynamic style tag or create a new one
            let style = document.getElementById('dynamic-page-size');
            if (!style) {
              style = document.createElement('style');
              style.id = 'dynamic-page-size';
              document.head.appendChild(style);
            }
            style.innerHTML = '@media print { @page { size: 58mm ' + heightMm + 'mm; margin: 0; } }';
          }
        }

        // Run immediately when parsed
        adjustPageHeight();

        // Run when DOM structure is ready
        document.addEventListener('DOMContentLoaded', adjustPageHeight);

        // Run when images and external assets are loaded
        window.addEventListener('load', adjustPageHeight);
      })();
    </script>
  </body>
</html>
